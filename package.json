{
  "name": "verichain",
  "version": "1.0.0",
  "description": "VeriChain - Plataforma web de emisión y verificación de credenciales digitales con Blockchain, Hash, Firma Digital Ed25519 y QR",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile:contracts": "hardhat compile",
    "test:contracts": "hardhat test test/CredentialRegistry.test.ts",
    "test:crypto": "tsx test/crypto.test.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "node:local": "hardhat node",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:scenarios": "tsx scripts/seed-demo-scenarios.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.6",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "ethers": "^6.13.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "otplib": "^12.0.1",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "hardhat": "^2.22.13",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
