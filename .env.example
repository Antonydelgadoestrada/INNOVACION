# ===================================================
# VERICHAIN - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ===================================================

# URL base de la aplicación (usada para la URL de verificación en el QR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de datos PostgreSQL (Supabase / PostgreSQL local)
# Para Supabase, usa el connection string de Transaction Pooler (puerto 6543) o Session (puerto 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verichain?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/verichain?schema=public"

# Supabase Auth y Storage
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"

# Clave maestra para cifrado simétrico AES-256-GCM de claves privadas Ed25519
# Debe ser una cadena hexadecimal de 64 caracteres (32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Configuración de Blockchain (Hardhat local o Sepolia)
BLOCKCHAIN_NETWORK="localhost"
LOCAL_RPC_URL="http://127.0.0.1:8545"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY"

# Dirección del contrato inteligente CredentialRegistry desplegado
# Se actualiza automáticamente al ejecutar npm run deploy:local o npm run deploy:sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Clave privada de la billetera del servidor que firma las transacciones
# En Hardhat local, la cuenta #0 predeterminada es:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SERVER_SIGNER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
